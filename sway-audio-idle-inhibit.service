[Unit]
Description=Prevents system from idling when there's an active audio source or sink

BindsTo=graphical-session.target
PartOf=graphical-session.target
After=graphical-session.target

# The unit is enabled for every graphical session (graphical-session.target),
# so without this it also runs in the Regolith X11 session, in GNOME sessions
# and in the login screen. Only the Regolith Wayland session uses it: its
# idle handling (swayidle) honours the logind idle inhibitor taken here.
ConditionEnvironment=XDG_SESSION_DESKTOP=regolith-wayland

[Service]
ExecStart=/usr/bin/sway-audio-idle-inhibit
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
